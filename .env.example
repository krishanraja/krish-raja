# ---------------------------------------------------------------------------
# Nothing here reaches the browser. Never add a VITE_ variable that holds an
# address or a key: Vite writes every VITE_ value into the public script, and
# the build fails if that script mentions a database (see vite.config.ts).
# ---------------------------------------------------------------------------

# Server-side only, read by api/enquiry.js (a Vercel function). Set both in the
# Vercel project's environment variables for Production. While either is unset
# the endpoint accepts and validates requests and records nothing.
#
# The full REST address of the table the enquiry rows are written to.
SITE_ENQUIRIES_URL=https://example.invalid/rest/v1/site_enquiries
# A server key allowed to insert into that table. Never commit a real value.
SITE_ENQUIRIES_KEY=replace-me
